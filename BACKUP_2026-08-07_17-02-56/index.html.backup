        <video autoplay muted loop playsinline>
            <source src="/images/hero-bg-2.mp4.mp4" type="video/mp4">
        </video>
        <div class="overlay"></div>
        <div class="content">
            <span class="tag">📊 Advanced Tools</span>
            <h2>Professional <span class="gold">Trading Tools</span></h2>
            <p>Access advanced charting tools, 50+ technical indicators, and real-time market data to make informed trading decisions.</p>
            <div class="cta-group">
                <a href="/register" class="btn-video btn-video-primary">Start Trading Free</a>
                <a href="#video3" class="btn-video btn-video-secondary">Learn More →</a>
            </div>
        </div>
    </section>

    <!-- ============================================================
         SECTION 8: VIDEO HERO 3 - Security First
         ============================================================ -->
    <section class="video-hero-full" id="video3">
        <video autoplay muted loop playsinline>
            <source src="/images/hero-bg-3.mp4.mp4" type="video/mp4">
        </video>
        <div class="overlay"></div>
        <div class="content">
            <span class="tag">🔒 Security First</span>
            <h2>Bank-Grade <span class="gold">Security</span></h2>
            <p>Your assets are protected with military-grade encryption, cold storage, and multi-factor authentication. Sleep better knowing your funds are safe.</p>
            <div class="cta-group">
                <a href="/register" class="btn-video btn-video-primary">Start Trading Free</a>
                <a href="#pairs" class="btn-video btn-video-secondary">View Markets →</a>
            </div>
        </div>
    </section>

    <!-- ============================================================
