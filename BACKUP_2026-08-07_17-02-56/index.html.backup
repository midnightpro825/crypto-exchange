            <span class="ticker-item"><span class="ticker-symbol">ETH/USDT</span><span class="ticker-price">$1,748.74</span><span class="ticker-change negative">-0.97%</span></span>
            <span class="ticker-item"><span class="ticker-symbol">SOL/USDT</span><span class="ticker-price">$152.30</span><span class="ticker-change positive">+2.15%</span></span>
            <span class="ticker-item"><span class="ticker-symbol">DOGE/USDT</span><span class="ticker-price">$0.12</span><span class="ticker-change negative">-3.25%</span></span>
            <span class="ticker-item"><span class="ticker-symbol">ADA/USDT</span><span class="ticker-price">$0.45</span><span class="ticker-change negative">-0.33%</span></span>
            <span class="ticker-item"><span class="ticker-symbol">AVAX/USDT</span><span class="ticker-price">$35.00</span><span class="ticker-change positive">+3.45%</span></span>
            <span class="ticker-item"><span class="ticker-symbol">PEPE/USDT</span><span class="ticker-price">$0.000012</span><span class="ticker-change positive">+5.80%</span></span>
            <span class="ticker-item"><span class="ticker-symbol">SHIB/USDT</span><span class="ticker-price">$0.000025</span><span class="ticker-change negative">-4.50%</span></span>
