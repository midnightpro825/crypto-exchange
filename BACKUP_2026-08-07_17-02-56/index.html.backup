<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TradeFlow - The Future of Crypto Trading</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ============================================================
           RESET & BASE - PRESERVED
           ============================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #0a0b0e;
            color: #ffffff;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ============================================================
           NAVIGATION - PRESERVED
           ============================================================ */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 18px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            background: rgba(10, 11, 14, 0.6);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            transition: all 0.4s ease;
        }

        .navbar.scrolled {
            background: rgba(10, 11, 14, 0.92);
            backdrop-filter: blur(30px);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 22px;
            font-weight: 800;
            color: #ffffff;
            text-decoration: none;
        }
        .logo-icon { color: #f0b90b; font-size: 28px; }
        .logo-highlight { color: #f0b90b; }

        .nav-links {
            display: flex;
            gap: 32px;
            align-items: center;
        }
        .nav-links a {
            color: rgba(255, 255, 255, 0.5);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.3s ease;
        }
        .nav-links a:hover { color: #ffffff; }

        .nav-buttons {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .btn-login {
            padding: 10px 28px;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
            text-decoration: none;
            display: inline-block;
        }
        .btn-login:hover {
            border-color: #f0b90b;
            color: #f0b90b;
            transform: translateY(-2px);
        }

        .btn-register {
            padding: 10px 32px;
            background: #f0b90b;
            border: none;
            border-radius: 10px;
            color: #0a0b0e;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
            text-decoration: none;
            display: inline-block;
        }
        .btn-register:hover {
            background: #f5c93d;
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(240, 185, 11, 0.3);
        }

        .btn-admin {
            padding: 10px 24px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 10px;
            color: #848e9c;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
            text-decoration: none;
            display: inline-block;
        }
        .btn-admin:hover {
            border-color: #f0b90b;
            color: #f0b90b;
            transform: translateY(-2px);
        }

        /* ============================================================
           HERO
           ============================================================ */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 120px 40px 80px;
            text-align: center;
            background: linear-gradient(180deg, #0a0b0e 0%, #14151a 40%, #0a0b0e 100%);
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 40%, rgba(240, 185, 11, 0.05) 0%, transparent 60%),
                        radial-gradient(ellipse at 70% 60%, rgba(240, 185, 11, 0.03) 0%, transparent 60%);
            animation: heroGlow 20s ease-in-out infinite alternate;
        }
        @keyframes heroGlow {
            0% { transform: translate(0, 0) rotate(0deg); }
            100% { transform: translate(2%, 2%) rotate(3deg); }
        }
        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 1000px;
            animation: fadeUp 1s ease-out;
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 20px;
            background: rgba(240, 185, 11, 0.08);
            border: 1px solid rgba(240, 185, 11, 0.15);
            border-radius: 100px;
            color: #f0b90b;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 32px;
        }
        .hero-badge .dot {
            width: 8px;
            height: 8px;
            background: #0ecb81;
            border-radius: 50%;
            display: inline-block;
            animation: pulseDot 1.5s infinite;
        }
        @keyframes pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.7); }
        }

        .hero h1 {
            font-size: 72px;
            font-weight: 900;
            line-height: 1.05;
            margin-bottom: 20px;
            letter-spacing: -2px;
        }
        .hero h1 .gold {
            background: linear-gradient(135deg, #f0b90b, #f5c93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero p {
            font-size: 20px;
            color: rgba(255, 255, 255, 0.6);
            max-width: 650px;
            margin: 0 auto 32px;
            line-height: 1.7;
        }

        .hero-features {
            display: flex;
            justify-content: center;
            gap: 32px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }
        .hero-features span {
            color: rgba(255, 255, 255, 0.5);
            font-size: 14px;
            font-weight: 500;
        }
        .hero-features .check { color: #0ecb81; margin-right: 6px; }

        .hero-buttons {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-primary {
            padding: 18px 52px;
            background: #f0b90b;
            border: none;
            border-radius: 12px;
            color: #0a0b0e;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
            text-decoration: none;
            display: inline-block;
        }
        .btn-primary:hover {
            background: #f5c93d;
            transform: translateY(-3px);
            box-shadow: 0 8px 40px rgba(240, 185, 11, 0.35);
        }

        .btn-secondary {
            padding: 18px 44px;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
            text-decoration: none;
            display: inline-block;
        }
        .btn-secondary:hover {
            border-color: #f0b90b;
            color: #f0b90b;
            transform: translateY(-3px);
        }

        /* ============================================================
           LIVE TICKER
           ============================================================ */
        .ticker-section {
            padding: 20px 0;
            background: rgba(255, 255, 255, 0.02);
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            overflow: hidden;
        }
        .ticker-track {
            display: flex;
            gap: 60px;
            animation: tickerScroll 35s linear infinite;
            white-space: nowrap;
        }
        .ticker-track:hover { animation-play-state: paused; }
        @keyframes tickerScroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .ticker-item {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 14px;
            color: rgba(255, 255, 255, 0.7);
            padding: 8px 16px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        .ticker-item:hover { background: rgba(255, 255, 255, 0.03); }
        .ticker-symbol { font-weight: 700; color: #ffffff; }
        .ticker-price { font-weight: 600; color: #ffffff; }
        .ticker-change { font-weight: 600; font-size: 13px; padding: 2px 10px; border-radius: 4px; }
        .ticker-change.positive { color: #0ecb81; background: rgba(14, 203, 129, 0.1); }
        .ticker-change.negative { color: #f6465d; background: rgba(246, 70, 93, 0.1); }

        /* ============================================================
           TRUST BAR
           ============================================================ */
        .trust-bar {
            padding: 60px 40px;
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }
        .trust-item {
            text-align: center;
            padding: 28px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 16px;
            transition: all 0.3s ease;
        }
        .trust-item:hover {
            transform: translateY(-4px);
            border-color: rgba(240, 185, 11, 0.1);
        }
        .trust-number {
            font-size: 42px;
            font-weight: 800;
            display: block;
        }
        .trust-number .gold { color: #f0b90b; }
        .trust-label {
            color: rgba(255, 255, 255, 0.4);
            font-size: 14px;
            font-weight: 500;
            margin-top: 4px;
        }

        /* ============================================================
           VIDEO HERO SECTIONS
           ============================================================ */
        .video-hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        .video-hero video,
        .video-hero-reverse video,
        .video-hero-full video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
        }

        .video-hero .overlay,
        .video-hero-reverse .overlay,
        .video-hero-full .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(180deg, rgba(10, 11, 14, 0.2) 0%, rgba(10, 11, 14, 0.7) 100%);
            z-index: 1;
        }

        .video-hero .content,
        .video-hero-reverse .content,
        .video-hero-full .content {
            position: relative;
            z-index: 2;
            max-width: 900px;
            padding: 40px;
            text-align: center;
        }

        .video-hero .content .tag,
        .video-hero-reverse .content .tag,
        .video-hero-full .content .tag {
            display: inline-block;
            padding: 6px 18px;
            background: rgba(240, 185, 11, 0.15);
            border: 1px solid rgba(240, 185, 11, 0.2);
            border-radius: 100px;
            color: #f0b90b;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 24px;
        }

        .video-hero .content h2,
        .video-hero-reverse .content h2,
        .video-hero-full .content h2 {
            font-size: 56px;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }
        .video-hero .content h2 .gold,
        .video-hero-reverse .content h2 .gold,
        .video-hero-full .content h2 .gold {
            background: linear-gradient(135deg, #f0b90b, #f5c93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .video-hero .content p,
        .video-hero-reverse .content p,
        .video-hero-full .content p {
            font-size: 18px;
            color: rgba(255, 255, 255, 0.7);
            max-width: 600px;
            margin: 0 auto 24px;
            line-height: 1.7;
        }

        .video-hero .content .cta-group,
        .video-hero-reverse .content .cta-group,
        .video-hero-full .content .cta-group {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-video {
            padding: 14px 40px;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
            text-decoration: none;
            display: inline-block;
        }
        .btn-video-primary {
            background: #f0b90b;
            color: #0a0b0e;
        }
        .btn-video-primary:hover {
            background: #f5c93d;
            transform: translateY(-3px);
            box-shadow: 0 8px 40px rgba(240, 185, 11, 0.3);
        }
        .btn-video-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        .btn-video-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-3px);
        }

        .video-hero-reverse { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
        .video-hero-full { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }

        /* ============================================================
           BANNER HERO
           ============================================================ */
        .banner-hero {
            position: relative;
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: url('/images/hero-bg.jpg.jpg') center/cover no-repeat;
        }
        .banner-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(180deg, rgba(10, 11, 14, 0.2) 0%, rgba(10, 11, 14, 0.8) 100%);
            z-index: 0;
        }
        .banner-hero .content {
            position: relative;
            z-index: 1;
            max-width: 900px;
            padding: 40px;
            text-align: center;
        }
        .banner-hero .content .tag {
            display: inline-block;
            padding: 6px 18px;
            background: rgba(240, 185, 11, 0.15);
            border: 1px solid rgba(240, 185, 11, 0.2);
            border-radius: 100px;
            color: #f0b90b;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 24px;
        }
        .banner-hero .content h2 {
            font-size: 52px;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }
        .banner-hero .content h2 .gold {
            background: linear-gradient(135deg, #f0b90b, #f5c93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .banner-hero .content p {
            font-size: 18px;
            color: rgba(255, 255, 255, 0.7);
            max-width: 600px;
            margin: 0 auto 24px;
            line-height: 1.7;
        }
        .banner-hero .content .stats-row {
            display: flex;
            justify-content: center;
            gap: 48px;
            margin-top: 24px;
            flex-wrap: wrap;
        }
        .banner-hero .content .stats-row .stat {
            text-align: center;
        }
        .banner-hero .content .stats-row .stat .num {
            font-size: 32px;
            font-weight: 800;
            color: #f0b90b;
            display: block;
        }
        .banner-hero .content .stats-row .stat .label {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.5);
        }

        /* ============================================================
           FEATURES GRID
           ============================================================ */
        .features {
            padding: 80px 40px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .section-title {
            text-align: center;
            font-size: 40px;
            font-weight: 800;
            margin-bottom: 12px;
            letter-spacing: -1px;
        }
        .section-title .gold {
            background: linear-gradient(135deg, #f0b90b, #f5c93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .section-subtitle {
            text-align: center;
            color: rgba(255, 255, 255, 0.5);
            font-size: 18px;
            max-width: 600px;
            margin: 0 auto 48px;
        }
        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }
        .feature-card {
            padding: 32px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 16px;
            text-align: center;
            transition: all 0.4s ease;
        }
        .feature-card:hover {
            transform: translateY(-8px);
            border-color: rgba(240, 185, 11, 0.1);
            background: rgba(255, 255, 255, 0.04);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        }
        .feature-icon { font-size: 48px; display: block; margin-bottom: 16px; }
        .feature-card h3 { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
        .feature-card p { color: rgba(255, 255, 255, 0.5); font-size: 14px; line-height: 1.7; }

        /* ============================================================
           AI BOT SECTION
           ============================================================ */
        .ai-section {
            padding: 80px 40px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .ai-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
            align-items: center;
        }
        .ai-grid .ai-content h2 {
            font-size: 40px;
            font-weight: 800;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }
        .ai-grid .ai-content h2 .gold {
            background: linear-gradient(135deg, #f0b90b, #f5c93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .ai-grid .ai-content p {
            color: rgba(255, 255, 255, 0.5);
            font-size: 16px;
            line-height: 1.7;
            margin-bottom: 16px;
        }
        .ai-grid .ai-content .features-list {
            list-style: none;
            padding: 0;
        }
        .ai-grid .ai-content .features-list li {
            padding: 8px 0;
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .ai-grid .ai-content .features-list li::before {
            content: '✓';
            color: #0ecb81;
            font-weight: 700;
            font-size: 18px;
        }
        .ai-grid .ai-image {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            min-height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
        .ai-grid .ai-image .emoji { font-size: 80px; margin-bottom: 16px; }
        .ai-grid .ai-image h3 { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
        .ai-grid .ai-image p { color: rgba(255, 255, 255, 0.5); font-size: 14px; }
        .ai-grid .ai-image .status-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            background: #0ecb81;
            border-radius: 50%;
            margin-right: 8px;
            animation: pulseDot 1.5s infinite;
        }

        /* ============================================================
           ABOUT US / GLOBAL
           ============================================================ */
        .about-section {
            padding: 80px 40px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
            align-items: center;
        }
        .about-grid .about-content h2 {
            font-size: 40px;
            font-weight: 800;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }
        .about-grid .about-content h2 .gold {
            background: linear-gradient(135deg, #f0b90b, #f5c93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .about-grid .about-content p {
            color: rgba(255, 255, 255, 0.5);
            font-size: 16px;
            line-height: 1.7;
            margin-bottom: 16px;
        }
        .about-grid .about-content .global-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-top: 24px;
        }
        .about-grid .about-content .global-stats .stat {
            text-align: center;
            padding: 16px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
        }
        .about-grid .about-content .global-stats .stat .num {
            font-size: 28px;
            font-weight: 800;
            color: #f0b90b;
            display: block;
        }
        .about-grid .about-content .global-stats .stat .label {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.4);
        }
        .about-grid .about-image {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            min-height: 250px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
        .about-grid .about-image .emoji { font-size: 64px; margin-bottom: 16px; }
        .about-grid .about-image h3 { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
        .about-grid .about-image p { color: rgba(255, 255, 255, 0.5); font-size: 14px; }

        /* ============================================================
           BOTTOM IMAGES
           ============================================================ */
        .bottom-images {
            padding: 60px 40px 80px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .bottom-images .image-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }
        .bottom-images .image-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.4s ease;
        }
        .bottom-images .image-card:hover {
            transform: translateY(-6px);
            border-color: rgba(240, 185, 11, 0.1);
        }
        .bottom-images .image-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            display: block;
        }
        .bottom-images .image-card .info {
            padding: 20px;
        }
        .bottom-images .image-card .info .tag {
            display: inline-block;
            padding: 4px 12px;
            background: rgba(240, 185, 11, 0.1);
            border-radius: 20px;
            color: #f0b90b;
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .bottom-images .image-card .info h4 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 6px;
        }
        .bottom-images .image-card .info p {
            color: rgba(255, 255, 255, 0.5);
            font-size: 13px;
            line-height: 1.6;
        }

        /* ============================================================
           PAIRS
           ============================================================ */
        .pairs {
            padding: 60px 40px 80px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .pairs-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-top: 32px;
        }
        .pair-card {
            padding: 16px 20px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .pair-card:hover {
            border-color: rgba(240, 185, 11, 0.1);
            transform: translateY(-3px);
        }
        .pair-left { display: flex; align-items: center; gap: 10px; }
        .pair-icon { font-size: 20px; }
        .pair-symbol { font-weight: 700; font-size: 14px; }
        .pair-price { font-weight: 600; font-size: 14px; }
        .pair-change { font-weight: 600; font-size: 12px; padding: 2px 8px; border-radius: 4px; margin-left: 6px; }
        .pair-change.positive { color: #0ecb81; background: rgba(14, 203, 129, 0.1); }
        .pair-change.negative { color: #f6465d; background: rgba(246, 70, 93, 0.1); }

        /* ============================================================
           CTA
           ============================================================ */
        .cta {
            padding: 80px 40px;
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }
        .cta h2 {
            font-size: 40px;
            font-weight: 800;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }
        .cta h2 .gold {
            background: linear-gradient(135deg, #f0b90b, #f5c93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .cta p {
            color: rgba(255, 255, 255, 0.5);
            font-size: 18px;
            margin-bottom: 32px;
        }

        /* ============================================================
           FOOTER
           ============================================================ */
        .footer {
            padding: 40px;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            text-align: center;
            color: rgba(255, 255, 255, 0.2);
            font-size: 14px;
        }
        .footer-links {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }
        .footer-links a {
            color: rgba(255, 255, 255, 0.15);
            text-decoration: none;
            font-size: 13px;
            transition: color 0.3s ease;
        }
        .footer-links a:hover { color: #ffffff; }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 1024px) {
            .hero h1 { font-size: 48px; }
            .video-hero .content h2,
            .video-hero-reverse .content h2,
            .video-hero-full .content h2,
            .banner-hero .content h2 { font-size: 40px; }
            .features-grid { grid-template-columns: repeat(2, 1fr); }
            .pairs-grid { grid-template-columns: repeat(2, 1fr); }
            .ai-grid { grid-template-columns: 1fr; }
            .about-grid { grid-template-columns: 1fr; }
            .bottom-images .image-grid { grid-template-columns: 1fr 1fr; }
        }

        @media (max-width: 768px) {
            .navbar { padding: 12px 20px; flex-wrap: wrap; gap: 12px; }
            .nav-links { display: none; }
            .hero { padding: 100px 20px 60px; }
            .hero h1 { font-size: 36px; }
            .hero p { font-size: 16px; }
            .hero-features { gap: 12px; flex-wrap: wrap; }
            .video-hero .content h2,
            .video-hero-reverse .content h2,
            .video-hero-full .content h2,
            .banner-hero .content h2 { font-size: 32px; }
            .video-hero .content p,
            .video-hero-reverse .content p,
            .video-hero-full .content p,
            .banner-hero .content p { font-size: 16px; }
            .video-hero .content .cta-group,
            .video-hero-reverse .content .cta-group,
            .video-hero-full .content .cta-group { flex-direction: column; align-items: center; }
            .video-hero .content .btn-video,
            .video-hero-reverse .content .btn-video,
            .video-hero-full .content .btn-video { width: 100%; text-align: center; }
            .trust-bar { grid-template-columns: 1fr 1fr; padding: 40px 20px; }
            .features { padding: 40px 20px; }
            .features-grid { grid-template-columns: 1fr; }
            .pairs { padding: 40px 20px; }
            .pairs-grid { grid-template-columns: 1fr; }
            .cta { padding: 40px 20px; }
            .cta h2 { font-size: 28px; }
            .section-title { font-size: 28px; }
            .footer { padding: 20px; }
            .footer-links { flex-direction: column; gap: 8px; }
            .hero-buttons { flex-direction: column; align-items: center; }
            .btn-primary, .btn-secondary { width: 100%; text-align: center; }
            .ai-section { padding: 40px 20px; }
            .ai-grid .ai-content h2 { font-size: 28px; }
            .about-section { padding: 40px 20px; }
            .about-grid .about-content h2 { font-size: 28px; }
            .about-grid .about-content .global-stats { grid-template-columns: 1fr 1fr; }
            .bottom-images { padding: 40px 20px; }
            .bottom-images .image-grid { grid-template-columns: 1fr; }
            .banner-hero .content .stats-row { gap: 24px; }
            .banner-hero .content .stats-row .stat .num { font-size: 24px; }
        }

        @media (max-width: 480px) {
            .trust-bar { grid-template-columns: 1fr; }
            .hero h1 { font-size: 28px; }
            .section-title { font-size: 22px; }
            .video-hero .content h2,
            .video-hero-reverse .content h2,
            .video-hero-full .content h2,
            .banner-hero .content h2 { font-size: 24px; }
            .nav-buttons .btn-login { display: none; }
            .about-grid .about-content .global-stats { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

